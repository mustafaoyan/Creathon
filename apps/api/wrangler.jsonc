{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubrix-api",
  // Ekip tek bir Cloudflare hesabını paylaşıyor; birden fazla hesaba erişimi olan
  // kullanıcılarda wrangler'ın doğru hesabı otomatik seçmesi için sabitlendi.
  "account_id": "4c93a1fdd11680cf952f1bf1c7f8f9b9",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rubrix-db",
      "database_id": "f586216e-5b03-4650-b898-590cc39f272c",
      "migrations_dir": "drizzle"
    }
  ],

  // `wrangler r2 bucket create rubrix-documents` ile bucket'ı oluştur (kaynak PDF/metinler).
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rubrix-documents"
    }
  ],

  // `wrangler vectorize create rubrix-embeddings --dimensions=1024 --metric=cosine`
  // (bge-m3 1024 boyutlu embedding üretir).
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rubrix-embeddings"
    }
  ],

  // Workers AI — çok dilli embedding modeli (bge-m3) için, ayrı kurulum gerektirmez.
  "ai": {
    "binding": "AI"
  },

  // `wrangler queues create rubrix-doc-processing` / `rubrix-question-generation`
  // ile kuyrukları oluştur. Soru üretimi kuyruğa taşındı ki tarayıcı sekmesi
  // kapansa/sayfa değişse de iş arka planda tamamlansın (bkz. questions.service.ts).
  "queues": {
    "producers": [
      { "binding": "DOC_QUEUE", "queue": "rubrix-doc-processing" },
      { "binding": "QUESTION_GEN_QUEUE", "queue": "rubrix-question-generation" }
    ],
    "consumers": [
      { "queue": "rubrix-doc-processing", "max_batch_size": 5, "max_retries": 3 },
      { "queue": "rubrix-question-generation", "max_batch_size": 3, "max_retries": 2 }
    ]
  },

  // Gizli olmayan config. Gizli değerler (`wrangler secret put <NAME>`):
  //   GOOGLE_CLIENT_SECRET, ANTHROPIC_API_KEY
  "vars": {
    "GOOGLE_CLIENT_ID": "920108344500-e5e30hsr3f6kb9rirpthhkk5ojaq2g30.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://rubrix-web.tahauguducu.workers.dev/api/auth/google/callback",
    "SESSION_COOKIE_SECURE": "true",
    "CF_ACCOUNT_ID": "4c93a1fdd11680cf952f1bf1c7f8f9b9",
    "CF_AI_GATEWAY_ID": "rubrix-gateway",
    // "anthropic" kredi gerektiriyor (bkz. CLAUDE.md) — kredi eklenene kadar
    // "workers-ai" kullanılıyor: Cloudflare'in kendi modelleri, günde 10.000
    // Neuron ücretsiz kota. Kredi eklenince tek satır değiştirip geri dönülür.
    "AI_PROVIDER": "workers-ai"
  },

  "observability": {
    "enabled": true
  }
}
