{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubrix-api",
  // Ekip tek bir Cloudflare hesabını paylaşıyor; birden fazla hesaba erişimi olan
  // kullanıcılarda wrangler'ın doğru hesabı otomatik seçmesi için sabitlendi.
  "account_id": "4c93a1fdd11680cf952f1bf1c7f8f9b9",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rubrix-db",
      "database_id": "f586216e-5b03-4650-b898-590cc39f272c",
      "migrations_dir": "drizzle"
    }
  ],

  // `wrangler r2 bucket create rubrix-documents` ile bucket'ı oluştur (kaynak PDF/metinler).
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rubrix-documents"
    }
  ],

  // `wrangler vectorize create rubrix-embeddings --dimensions=1024 --metric=cosine`
  // (bge-m3 1024 boyutlu embedding üretir).
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rubrix-embeddings"
    }
  ],

  // Workers AI — çok dilli embedding modeli (bge-m3) için, ayrı kurulum gerektirmez.
  "ai": {
    "binding": "AI"
  },

  // `wrangler queues create rubrix-doc-processing` / `rubrix-question-generation`
  // ile kuyrukları oluştur. Soru üretimi kuyruğa taşındı ki tarayıcı sekmesi
  // kapansa/sayfa değişse de iş arka planda tamamlansın (bkz. questions.service.ts).
  "queues": {
    "producers": [
      { "binding": "DOC_QUEUE", "queue": "rubrix-doc-processing" },
      { "binding": "QUESTION_GEN_QUEUE", "queue": "rubrix-question-generation" }
    ],
    "consumers": [
      { "queue": "rubrix-doc-processing", "max_batch_size": 5, "max_retries": 3 },
      { "queue": "rubrix-question-generation", "max_batch_size": 3, "max_retries": 2 }
    ]
  },

  // Gizli olmayan config. Gizli değerler (`wrangler secret put <NAME>`):
  //   GOOGLE_CLIENT_SECRET, ANTHROPIC_API_KEY, RESEND_API_KEY
  "vars": {
    "GOOGLE_CLIENT_ID": "920108344500-e5e30hsr3f6kb9rirpthhkk5ojaq2g30.apps.googleusercontent.com",
    // 2026-08-25: özel domain'e geçildi (app.hititai.com). Eski workers.dev URL'i
    // ÇALIŞMIYOR (bilinçli — Cloudflare aynı hesaptaki iki worker'ın service
    // binding ile birbirini workers.dev üzerinden çağırmasını engelliyor, "error
    // code 1042"; custom domain'de sorun yok). Google OAuth callback de zaten tek
    // bir redirect_uri kullanıyor, artık sadece app.hititai.com üzerinden geçerli.
    "GOOGLE_REDIRECT_URI": "https://app.hititai.com/api/auth/google/callback",
    "SESSION_COOKIE_SECURE": "true",
    "CF_ACCOUNT_ID": "4c93a1fdd11680cf952f1bf1c7f8f9b9",
    "CF_AI_GATEWAY_ID": "rubrix-gateway",
    // 2026-08-25: "Kredi eklendi" denendi ama Anthropic hâlâ aynı hatayı
    // veriyor ("credit balance too low") — gerçek testte doğrulandı, "workers-ai"a
    // geri alındı. Muhtemelen kredi yanlış hesaba/API key'e eklendi ya da
    // henüz işlenmedi. Gerçekten doğrulanınca "anthropic" yapılabilir.
    "AI_PROVIDER": "workers-ai",
    // Bilgilerim > E-posta Değiştir doğrulama kodları buradan gönderiliyor
    // (bkz. shared/lib/email.ts). hititai.com Resend'de doğrulanmadan bu adres
    // gerçek e-posta gönderemez — sadece Resend'in test/sandbox kısıtlarına tabi olur.
    "EMAIL_FROM": "RubriX <noreply@hititai.com>"
  },

  "observability": {
    "enabled": true
  }
}
