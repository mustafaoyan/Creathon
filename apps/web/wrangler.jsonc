{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubrix-web",
  "account_id": "4c93a1fdd11680cf952f1bf1c7f8f9b9",
  "main": "src/worker/index.tsx",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Without this, a static file that happens to match a request path (notably
    // dist/client/index.html at "/") is served directly and never reaches our
    // SSR fetch handler below — that's what was silently breaking "/" after login.
    "run_worker_first": true
  },
  // Service binding to rubrix-api — same-origin proxying for /api/*, see worker/index.tsx.
  // Local dev: run `pnpm --filter @rubrix/api dev` alongside this so the binding resolves.
  "services": [{ "binding": "API", "service": "rubrix-api" }],
  // 2026-08-25: hititai.com satın alındı, custom domain buraya bağlandı.
  // workers_dev BİLİNÇLİ OLARAK false (varsayılan) — açık tutmayı denedik ama
  // Cloudflare, aynı hesaptaki iki worker service binding ile birbirini
  // çağırdığında (bizim /api/* proxy deseni, rubrix-web -> rubrix-api) bunu
  // *.workers.dev üzerinden YASAKLIYOR (her istekte "error code: 1042" —
  // bu, worker-to-worker fetch'in workers.dev'den erişildiğinde Cloudflare
  // tarafından engellenen bilinen bir kısıtlama, custom domain'de sorun yok).
  // Yani workers.dev'i açık bıraksak bile kırık/yarım çalışırdı — kafa
  // karıştırmasın diye tamamen kapalı tutuyoruz, tek adres artık app.hititai.com.
  "routes": [{ "pattern": "app.hititai.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  }
}
