{
  "name": "my-app",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @my-app/api dev",
    "dev:web": "pnpm --filter @my-app/web dev",
    "build": "pnpm -r --filter=./apps/* build",
    "typecheck": "pnpm -r --filter=./apps/* typecheck",
    "lint": "pnpm -r --filter=./apps/* lint",
    "db:generate": "pnpm --filter @my-app/api db:generate",
    "db:migrate:local": "pnpm --filter @my-app/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @my-app/api db:migrate:remote"
  }
}
